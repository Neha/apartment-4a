# User API key from https://cursor.com/dashboard/integrations
# Leave unset if you connect from the Integrations panel instead.
CURSOR_API_KEY=

# Optional. Local agents require a model. composer-2.5 is the default.
CURSOR_MODEL=composer-2.5

# Password for the Apartment 4A sign-in page. Required.
APP_PASSWORD=

# Optional. Set to "false" only when serving over plain HTTP on a trusted LAN
# (the session cookie is otherwise Secure in production and browsers drop it on http://).
COOKIE_SECURE=
